<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only paints the window before Compose draws, so launch doesn't flash the wrong colour. -->
    <style name="Theme.Redline" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/redline_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
