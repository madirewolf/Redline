<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up. The Anthropic API key stays on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="redline_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="redline_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
